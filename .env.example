# Copy to .env and fill in. All keys are optional; missing ones fall back gracefully.

# --- Crustdata (people & company data) -------------------------------------
# auto | mcp | rest | demo. "auto" = MCP over Streamable HTTP.
CRUSTDATA_TRANSPORT=auto
# With a key: MCP uses "Authorization: Bearer <key>". Without one: sign in via OAuth from the app header.
CRUSTDATA_API_KEY=
CRUSTDATA_MCP_URL=https://install.crustdata.com/mcp
# Credit controls
CRUSTDATA_SEARCH_LIMIT=40
CRUSTDATA_MAX_QUERIES=4
CRUSTDATA_ENRICH_PER_PAGE=50
CRUSTDATA_RESEARCH_PROFILES=true
CRUSTDATA_DEV_PLATFORM_PROFILES=true
CRUSTDATA_ACADEMIC_WEB_SEARCH=true

# --- LLM: DeepSeek ---------------------------------------------------------
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_FAST_MODEL=deepseek-flash
LLM_JUDGE_REASONING=low
LLM_CONCURRENCY=8

# --- Reranker: TypeSafe Jev ------------------------------------------------
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
# auto | hybrid | llm | jev | heuristic
RANKER=auto
HYBRID_JEV_WEIGHT=0.5

PORT=8787
