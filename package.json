{
  "name": "expertmatch",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered research & engineering collaboration discovery, backed by Crustdata (MCP over Streamable HTTP or REST) and Claude.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"server/test/**/*.test.js\"",
    "check": "npm run typecheck && npm test && npm run build",
    "benchmark:rankers": "node server/scripts/benchmark-rankers.js",
    "check:ranker": "node server/scripts/check-ranker.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
